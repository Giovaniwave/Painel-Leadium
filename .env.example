# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=

# OPENAI_API_KEY: Required for OpenAI GPT-4o-mini financial virtual assistant calls.
OPENAI_API_KEY=

# GROQ_API_KEY: Required to transcribe voice messages sent to Kairos (Whisper via Groq's free API).
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=

# SUPABASE_URL: Direct Supabase database API URL
SUPABASE_URL=

# SUPABASE_SERVICE_ROLE_KEY: somente backend. Nunca use VITE_ nem envie ao navegador.
# Em produção o servidor não aceita a chave anon para acessar dados privados.
SUPABASE_SERVICE_ROLE_KEY=

# Segredo obrigatório enviado pelo n8n no header x-webhook-secret.
LEAD_WEBHOOK_SECRET=

# ASAAS: gateway de pagamentos (cobrança de clientes Leadium).
# Chave de API — use a de Sandbox (sandbox.asaas.com) até validar tudo, produção só depois.
ASAAS_API_KEY=
# sandbox | production
ASAAS_ENV=sandbox
# Token que você mesmo define e cadastra no painel Asaas (Webhooks), enviado de volta no header asaas-access-token.
ASAAS_WEBHOOK_TOKEN=

